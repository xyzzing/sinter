{
  "schema_version": 1,
  "suite_id": "coding-core-v2",
  "domain": "coding",
  "title": "Coding core governed task suite (v2)",
  "description": "End-to-end coding tasks graded by the repository's own tests. Ports the two fixtures proven in minder/benchmarks/coding-core-v1 and adds a fixture-repair task. Grading is a pytest run the harness performs in a fresh workspace; the agent's own report is never the evidence.",
  "tasks": [
