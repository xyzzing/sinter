      "fixtures": [
        "tasks/keyerror_default/task.py",
        "tasks/keyerror_default/test_task.py"
      ],
      "graders": [
        {
          "type": "pytest",
          "entry": [
            "tasks/keyerror_default/test_task.py"
          ]
        },
        {
          "type": "command",
          "argv": [
            "python3",
            "-m",
            "pytest",
            "-q",
            "--rootdir",
            "tasks/keyerror_default",
            "-c",
            "pytest.ini",
            "tasks/keyerror_default/test_task.py"
          ]
        }
      ],
      "expected": "tests_pass",
      "budgets": {
        "wall_seconds": 900,
        "token_budget": 40000,
        "max_turns": 25
      }
    },
    {
      "task_id": "t3_assertion_expectation",
      "kind": "coding",
      "title": "Fix an off-by-one so the assertion matches the expectation",
      "kickoff": "tasks/assertion_expectation/kickoff.md",
